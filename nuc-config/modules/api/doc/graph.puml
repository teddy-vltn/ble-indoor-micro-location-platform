@startuml api_graph
hide empty members
set namespaceSeparator none

interface "/graph" {
}

class "PUT /graph" {
.. body ..
{field} Graph <b>payload</b>
.. responses ..
200: {field} GenericSuccessResponse 
400: {field} ErrorResponse 
}

"PUT /graph" ..> Graph

class "GET /graph" {
.. header ..
{field} string (mask) X-Fields
.. responses ..
200: {field} GraphSuccessResponse 
400: {field} ErrorResponse 
}

"GET /graph" ..> GraphSuccessResponse

"/graph" ..> "GET /graph"
"/graph" ..> "PUT /graph"

interface "/graph/download" {
}

class "GET /graph/download" {
.. responses ..
200: {field} graph.yaml
400: {field} ErrorResponse 
}

"/graph/download" ..> "GET /graph/download"

class Graph {
    {field} Node[] nodes
    {field} Edge[] edges
}

Graph ..> Edge
Graph ..> Node

class Node {
    {field} string <b>id</b>
    {field} string <b>name</b>
    {field} number <b>x</b>
    {field} number <b>y</b>
}

class Edge {
    {field} string <b>from</b>
    {field} string <b>to</b>
}

class GraphSuccessResponse {
    {field} string message
    {field} string status
    {field} Graph data
    {field} integer code
}

GraphSuccessResponse ..> Graph

@enduml
